# Copy to .env (local) or set in Vercel → Settings → Environment Variables.

# Postgres — local Docker, or a Neon pooled connection string in production:
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/critique?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/critique"

# Better Auth — generate with: openssl rand -hex 32
AUTH_SECRET="replace-me"
# The canonical origin of the deployment (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
# Extra origins allowed for auth requests (dev servers on other ports).
BETTER_AUTH_TRUSTED_ORIGINS="" # optional, comma-separated

# Magic links are printed to the server console — there is no email service by
# design. No SMTP keys needed.

# Google sign-in is optional and only renders when all three are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# PageSpeed Insights API key (optional but recommended — your own quota instead
# of the shared keyless one). Enable "PageSpeed Insights API" in Google Cloud,
# then create an API key under Credentials.
PSI_API_KEY=""

# "Ask the AIs" providers (OpenAI-compatible, free tiers available).
# With no keys the panel degrades to an honest "no api key" state.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
